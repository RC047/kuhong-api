{
    "name": "kuhong-api",
    "type": "library",
    "description": "Just A Simple API",
    "keywords": ["web", "rest-api", "api"],
    "license": "MIT",
    "homepage": "https://github.com/RC047/kuhong-api",
    "support": {
        "issues": "https://github.com/RC047/kuhong-api/issues",
        "source": "https://github.com/RC047/kuhong-api"
    },
    "authors": [
        {
           "name": "RC047",
           "homepage": "https://github.com/RC047",
           "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.5",
        "dms/phpunit-arraysubset-asserts": "^0.2",
        "monolog/monolog": "^2.1"
    },
    "config": {
        "optimize-autoloader": false,
        "preferred-install": "dist",
